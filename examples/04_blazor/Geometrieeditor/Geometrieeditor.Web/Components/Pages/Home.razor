@page "/"
@using Geometrieeditor.Fachkonzept
@inject FigurenVerwaltung Verwaltung

<PageTitle>Geometrieeditor</PageTitle>

<div class="werkzeuge">
    <button @onclick="() => dialogOffen = true">Neue Figur …</button>
    <button @onclick="Entfernen" disabled="@(ausgewaehlt is null)">Entfernen</button>
    <button @onclick="Verschieben" disabled="@(ausgewaehlt is null)">Verschieben</button>
    <button @onclick="Laden">Laden</button>
    <button @onclick="Speichern">Speichern</button>
</div>

<div class="arbeitsbereich">
    <ul class="figurenliste">
        @foreach (Figur figur in Verwaltung.AlleFiguren)
        {
            <li class="@(figur == ausgewaehlt ? "ausgewaehlt" : "")"
                @onclick="() => ausgewaehlt = figur">@figur.Name</li>
        }
    </ul>

    <div class="details">
        @if (ausgewaehlt is null)
        {
            <p>Keine Figur ausgewählt.</p>
        }
        else
        {
            <p>@ausgewaehlt.Beschreibung()</p>
            <p>Umfang: @ausgewaehlt.Umfang.ToString("F2")</p>
        }
    </div>
</div>

<p class="status">@status</p>

@if (dialogOffen)
{
    <NeueFigurDialog OnGeschlossen="DialogGeschlossen" />
}

@code {
    // Die Seite kennt nur die Fachkonzept-Schicht (FigurenVerwaltung).
    // Welcher Speicher dahinter steckt, entscheidet Program.cs.
    private Figur? ausgewaehlt;
    private bool dialogOffen = false;
    private string status = "";

    protected override void OnInitialized()
    {
        StatusAktualisieren();
    }

    private void StatusAktualisieren()
    {
        status = $"{Verwaltung.AlleFiguren.Count} Figuren, Gesamtfläche {Verwaltung.GesamtFlaeche():F2}";
    }

    private void DialogGeschlossen(Figur? neueFigur)
    {
        dialogOffen = false;
        if (neueFigur is null)
        {
            status = "Abgebrochen.";
            return;
        }

        try
        {
            Verwaltung.Hinzufuegen(neueFigur);
            StatusAktualisieren();
        }
        catch (ArgumentException ex)
        {
            status = ex.Message;
        }
    }

    private void Entfernen()
    {
        if (ausgewaehlt is not null)
        {
            Verwaltung.Entfernen(ausgewaehlt);
            ausgewaehlt = null;
            StatusAktualisieren();
        }
    }

    private void Verschieben()
    {
        ausgewaehlt?.Verschieben(10, 10);
    }

    private void Laden()
    {
        Verwaltung.Laden();
        ausgewaehlt = null;
        StatusAktualisieren();
    }

    private void Speichern()
    {
        Verwaltung.Speichern();
        status = "Gespeichert.";
    }
}
